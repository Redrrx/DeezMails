# Backend configuration. Copy to .env or backend/.env; environment variables override.
# The static demo does not use this file.
HOST=0.0.0.0
PORT=8080

# Database and required secrets.
DATABASE_URL=
CREDENTIALS_ENCRYPTION_KEY=
DEEZMAILS_ACCESS_TOKEN=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=

# Bounded worker and mailbox settings.
WORKER_CONCURRENCY=1
SYNC_INTERVAL_MINUTES=15
SCHEDULER_BATCH_SIZE=50
SYNC_MAX_PAGES=5
SYNC_MAX_MESSAGES=500
SYNC_MAX_FOLDERS=500
JOB_TIMEOUT_MINUTES=10
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
MAX_MESSAGE_BYTES=67108864

# Keep false unless plaintext mail authentication is unavoidable on a trusted network.
DEEZMAILS_ALLOW_INSECURE_MAIL=false
